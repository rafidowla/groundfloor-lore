#!/bin/bash
# ─── Groundfloor Lore — Post-Commit Hook ──────────────────────
# Automatically re-indexes the code graph after each commit.
#
# What it does:
#   1. Runs `gitnexus analyze .` to extract code symbols/relations
#   2. Sends a re-index signal to the Lore daemon (if running)
#
# Install:
#   cp scripts/hooks/post-commit .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit
#
# Or use `lore setup` which installs this automatically.
# ───────────────────────────────────────────────────────────────

LORE_PORT="${LORE_PORT:-3847}"
LORE_DAEMON="http://127.0.0.1:${LORE_PORT}"

# Run GitNexus analysis in background (non-blocking)
if command -v npx &> /dev/null; then
    echo "[lore] Re-indexing code graph..."
    npx gitnexus analyze . --quiet 2>/dev/null &
    GITNEXUS_PID=$!

    # Wait up to 30s, then detach if still running
    ( sleep 30 && kill $GITNEXUS_PID 2>/dev/null ) &
    WATCHDOG_PID=$!

    wait $GITNEXUS_PID 2>/dev/null
    EXIT_CODE=$?
    kill $WATCHDOG_PID 2>/dev/null

    if [ $EXIT_CODE -eq 0 ]; then
        echo "[lore] ✓ Code graph updated"
    else
        echo "[lore] ⚠ Code graph update failed (non-blocking)"
    fi
else
    echo "[lore] ⚠ npx not found — skipping code graph update"
fi
