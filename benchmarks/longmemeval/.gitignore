# Downloaded dataset — large (277MB for _s, ~2.7GB for _m), publicly
# re-downloadable via README.md "Dataset acquisition" instructions.
data/*.json

# Embedded Lore data directory generated by runSubset.ts (SurrealDB + LanceDB).
lore-home/
lore-home-*/

# Results are committed as evidence (they're small — tens of KB at
# subset scale). No ignore rule here on purpose.

# API keys for the answering/judge models. Never committed, never pasted
# into chat — create this file directly (OPENAI_API_KEY=..., one per line),
# loaded at runtime via `node --env-file=.env`.
.env
