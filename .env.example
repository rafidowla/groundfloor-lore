# Lore Service — environment variable reference
#
# Copy to .env and fill in values for your environment. The Lore daemon
# reads these at boot via process.env (no .env loader at runtime — your
# launchd plist / docker-compose / shell exports them).

# ─── Mode + workspace ────────────────────────────────────────────────

# CLI flag --mode=local|cloud overrides this. Default 'local'.
LORE_DEPLOYMENT_MODE=local

# Optional override for workspace home. Default: ~/.groundfloor
# LORE_HOME=/path/to/your/.groundfloor

# ─── Dataplane (cloud-mode only) ─────────────────────────────────────

# Base URL of the Groundfloor Dataplane HTTP API.
DATAPLANE_URL=http://localhost:8080

# Tenant-scoped API key minted by Dataplane after tenant registration.
# Lore reads this in cloud mode to construct GroundfloorClient.
# For local-mode dev: set after running scripts/bootstrap-dataplane.mjs.
DATAPLANE_API_KEY=

# Privileged token for tenant registration. Only used by
# scripts/bootstrap-dataplane.mjs — NOT read by the running Lore service.
# Generate with `openssl rand -hex 32`; must match Dataplane container's
# ADMIN_TOKEN. Once tenant is registered, this is irrelevant.
DATAPLANE_ADMIN_TOKEN=

# Tenant id for this Lore install. One tenant can host multiple Lore
# workspaces — each Lore workspace maps to a portal_workspace inside
# this tenant. NOTE: the code reads DATAPLANE_TENANT_ID (services.ts); a
# bare TENANT_ID is ignored and the tenant silently defaults to an internal
# value. Set DATAPLANE_TENANT_ID, not TENANT_ID.
DATAPLANE_TENANT_ID=lore

# Default org/account id (portal_account) Lore writes belong to. Used
# when no per-request account is resolved from the JWT.
DATAPLANE_ORG_ID=default

# ─── Service-to-service auth (DEF/Loom → Lore) ──────────────────────

# Pre-supplied shared secret that DEF/Loom uses to authenticate to
# Lore's MCP server in cloud mode. Lore validates incoming Bearer
# tokens against this. Populate from a secrets manager at deploy time.
# Local mode: leave empty — DEF uses the localhost-only /api/auth/bootstrap.
LORE_MCP_AUTH_TOKEN=

# ─── Clerk (cloud-mode user auth) ────────────────────────────────────

# Clerk JWKS URL for validating end-user JWTs at the HTTP edge.
# CLERK_ISSUER=https://your-tenant.clerk.accounts.dev
# CLERK_AUDIENCE=lore
# CLERK_JWKS_CACHE_S=600

# ─── Bootstrap-script-only ───────────────────────────────────────────
# These are read by scripts/bootstrap-dataplane.mjs only.

# portal_user id to grant `owner` of the bootstrap workspace.
# LORE_BOOTSTRAP_USER_ID=

# portal_workspace id to seed (default: lore-default).
# LORE_BOOTSTRAP_WORKSPACE_ID=

# ─── MCP shim (operator choice) ──────────────────────────────────────

# When 'on', tools/list returns only lore_tool_list / _schema / _invoke.
# DEF auto-routes around this; only relevant if you're hitting MCP from
# a non-shim-aware client.
# LORE_TOOL_SHIM=off
