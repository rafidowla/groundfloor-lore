{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "outDir": "dist",
        "rootDir": "packages",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@lore-core/*": ["packages/lore/src/*"],
            "@lore-plugin-developer/*": ["packages/lore-plugin-developer/src/*"],
            "@lore-plugin-personal/*": ["packages/lore-plugin-personal/src/*"],
            "@lore-plugin-legal/*": ["packages/lore-plugin-legal/src/*"]
        }
    },
    "include": [
        "packages/lore/src/**/*",
        "packages/lore-plugin-developer/src/**/*",
        "packages/lore-plugin-personal/src/**/*",
        "packages/lore-plugin-legal/src/**/*"
    ],
    "exclude": ["node_modules", "dist", "ui"]
}
