{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Lore",
    "version": "0.1.0",
    "identifier": "com.groundfloor.lore.shell",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Lore",
                "width": 1100,
                "height": 720,
                "minWidth": 800,
                "minHeight": 500,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": ["icons/icon.png"]
    }
}
