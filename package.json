{
    "name": "@groundfloor/lore",
    "version": "0.1.0",
    "description": "Unified code intelligence + institutional knowledge MCP server. Local-first Kùzu graph with SurrealDB team sync.",
    "type": "module",
    "main": "dist/lore/src/mcp/server.js",
    "bin": {
        "lore": "dist/lore/src/cli/index.js"
    },
    "scripts": {
        "build": "tsc && tsc-alias",
        "start": "node dist/lore/src/mcp/server.js",
        "dev": "tsx packages/lore/src/mcp/server.ts",
        "cli": "tsx packages/lore/src/cli/index.ts",
        "test:http": "tsx test/http-test.ts",
        "test:arch": "node scripts/test-arch.mjs",
        "test:e2e:phase-7a": "tsx test/e2e-phase-7a.ts",
        "test:e2e:language": "tsx test/e2e-language.ts",
        "test:e2e:all": "tsx test/run-all-e2e.ts",
        "test": "npm run test:arch && tsc --noEmit"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.14",
        "@huggingface/transformers": "^4.1.0",
        "@kineviz/kuzu-lite": "^0.11.3",
        "@lancedb/lancedb": "^0.27.2",
        "@modelcontextprotocol/sdk": "^1.12.1",
        "franc": "^6.2.0",
        "gitnexus": "1.4.10",
        "groundfloor-ts-sdk": "file:../v3/groundfloor-ts-sdk",
        "hono": "^4.12.14",
        "keytar": "^7.9.0",
        "mailparser": "^3.9.8",
        "mammoth": "^1.12.0",
        "pdfjs-dist": "^5.6.205",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@types/mailparser": "^3.4.6",
        "@types/node": "^20.11.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
