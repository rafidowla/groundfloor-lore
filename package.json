{
    "name": "@groundfloor/lore",
    "version": "0.1.0",
    "description": "Unified code intelligence + institutional knowledge MCP server. Local-first Kùzu graph with SurrealDB team sync.",
    "type": "module",
    "main": "dist/lore/src/mcp/server.js",
    "bin": {
        "lore": "dist/lore/src/cli/index.js"
    },
    "scripts": {
        "build": "tsc && tsc-alias",
        "start": "node dist/lore/src/mcp/server.js",
        "dev": "tsx packages/lore/src/mcp/server.ts",
        "cli": "tsx packages/lore/src/cli/index.ts",
        "test:http": "tsx test/http-test.ts",
        "test:arch": "node scripts/test-arch.mjs",
        "test:cache": "tsx test/cache-unit.ts",
        "test:unit:dataplane-graph": "tsx test/dataplane-graph-unit.ts",
        "test:unit:dataplane-vector": "tsx test/dataplane-vector-store-unit.ts",
        "test:unit:embedding-provider": "tsx test/embedding-provider-unit.ts",
        "test:unit:openai-compat-embedding": "tsx test/openai-compat-embedding-provider-unit.ts",
        "test:unit:embedding-fingerprint": "tsx test/embedding-fingerprint-unit.ts",
        "test:unit:plugin-storage": "tsx test/plugin-storage-unit.ts",
        "bench:cache": "node scripts/bench-cache.mjs",
        "test:e2e:phase-7a": "tsx test/e2e-phase-7a.ts",
        "test:e2e:language": "tsx test/e2e-language.ts",
        "test:e2e:q2-1": "tsx test/e2e-q2-1-server-mode.ts",
        "test:e2e:q2-2": "tsx test/e2e-q2-2-cloud-roundtrip.ts",
        "test:e2e:all": "tsx test/run-all-e2e.ts",
        "test:scaffold-plugin": "tsx test/scaffold-plugin.test.ts",
        "test:unit:deferred": "tsx test/unit-deferred.ts",
        "test:manifest:developer": "tsx test/manifest-developer-plugin.test.ts",
        "test:manifest:reference": "tsx test/manifest-reference-plugins.test.ts",
        "test:manifest:loader": "tsx test/manifest-loader-unit.ts",
        "test:manifest:ingest": "tsx test/manifest-ingest-unit.ts",
        "test": "npm run test:arch && npm run test:cache && npm run test:unit:dataplane-graph && npm run test:unit:dataplane-vector && npm run test:unit:embedding-provider && npm run test:unit:openai-compat-embedding && npm run test:unit:embedding-fingerprint && npm run test:unit:plugin-storage && tsc --noEmit && npm run test:unit:deferred && npm run test:manifest:loader && npm run test:manifest:ingest && npm run test:manifest:developer && npm run test:manifest:reference"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.14",
        "@huggingface/transformers": "^4.1.0",
        "@kineviz/kuzu-lite": "^0.11.3",
        "@lancedb/lancedb": "^0.27.2",
        "@modelcontextprotocol/sdk": "^1.12.1",
        "csv-parse": "^5.6.0",
        "franc": "^6.2.0",
        "gitnexus": "1.4.10",
        "groundfloor-ts-sdk": "file:../v3/groundfloor-ts-sdk",
        "hono": "^4.12.14",
        "keytar": "^7.9.0",
        "mailparser": "^3.9.8",
        "mammoth": "^1.12.0",
        "pdfjs-dist": "^5.6.205",
        "tesseract.js": "^7.0.0",
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@types/mailparser": "^3.4.6",
        "@types/node": "^20.11.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=20.0.0"
    }
